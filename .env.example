# Epic FHIR OAuth2 Configuration
# Copy this file to .env and fill in your actual values

# Your Epic FHIR application client ID (required)
# Obtain this by registering your application at Epic's FHIR portal
EPIC_CLIENT_ID=

# Path to your private key file (RS384) (required)
# This private key must match the public key you uploaded to Epic
# Generate: openssl genrsa -out .keys/privatekey.pem 2048
# Extract public: openssl rsa -in .keys/privatekey.pem -pubout -out .keys/publickey.pem
EPIC_PRIVATE_KEY_PATH=./.keys/privatekey.pem

# Epic OAuth2 token endpoint (optional - defaults to sandbox)
# Sandbox: https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token
# Production: (will be provided by Epic for your organization)
EPIC_TOKEN_ENDPOINT=https://fhir.epic.com/interconnect-fhir-oauth/oauth2/token

# JWT Key ID for JWKS (optional but recommended)
# Used when Epic looks up your public key via JWKS endpoint
# Should match the 'kid' value in your JWKS JSON
EPIC_JWT_KID=genserve-key-1
